# ─────────────────────────────────────────────────────────────────────────────
# allow-git
#
# Baileys 6.7.x declares `libsignal` — the Signal protocol implementation, i.e.
# its core crypto — as a RUNTIME dependency resolved from GitHub rather than the
# npm registry:
#
#   "libsignal": "git+https://github.com/whiskeysockets/libsignal-node"
#
# npm 11.7+/12 disabled git fetching by default (error code EALLOWGIT). Without
# this setting Baileys cannot be installed at all — not locally and not on
# Railway. A CLI flag fixes a laptop; this file is what makes the Railway build
# work too, because Railway runs a plain `npm ci` with no flags of ours.
#
# The lockfile pins libsignal to an exact commit SHA, so this permits fetching
# from git — it does not permit drifting to whatever is on the branch today.
# Re-check that SHA when you bump Baileys.
#
# Baileys 7.x replaces libsignal with a first-party implementation, so this
# line can be deleted on that migration.
allow-git=all

# ─────────────────────────────────────────────────────────────────────────────
# allow-scripts
#
# protobufjs runs a postinstall that npm now blocks by default. Baileys decodes
# every WhatsApp message through protobuf (WAProto), so allow it explicitly
# rather than blanket-enabling install scripts for the whole dependency tree.
#
# @whiskeysockets/baileys' own preinstall is only a Node version check and is
# deliberately NOT allowed here — leaving it blocked costs nothing.
allow-scripts=protobufjs
